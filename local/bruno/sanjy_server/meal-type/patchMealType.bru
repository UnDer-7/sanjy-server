example {
  name: fail | Meal Type Not Found
  
  request: {
    url: {{SERVER_URL}}/v1/meal-type/99
    method: PATCH
    mode: json
    body:json: {
      {
        "name": "Pre-workout snack - UPDATED",
        "scheduledTime": "23:59:59",
        "observation": "ggwp"
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      transfer-encoding: chunked
      date: Wed, 29 Apr 2026 02:53:51 GMT
      keep-alive: timeout=60
      connection: keep-alive
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "code": "007",
          "timestamp": "2026-04-29T02:53:51.638415829Z",
          "message": "Meal Type was not found",
          "customMessage": "Could not find meal type with id 99",
          "httpStatusCode": 422
        }
      '''
    }
  }
}
