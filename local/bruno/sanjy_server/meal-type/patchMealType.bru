meta {
  name: patchMealType
  type: http
  seq: 1
}

patch {
  url: {{SERVER_URL}}/v1/meal-type/1
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Pre-workout snack - UPDATED",
    "scheduledTime": "23:59:59",
    "observation": "ggwp"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

